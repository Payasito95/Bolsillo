{
  "name": "Bolsillo",
  "short_name": "Bolsillo",
  "description": "Tus gastos en pesos y dólares, con plan semanal, cuotas y fijos.",
  "lang": "es-AR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#EFF3EE",
  "theme_color": "#1E7A58",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "archivo",
          "accept": [
            "image/*",
            "application/pdf",
            ".pdf"
          ]
        }
      ]
    }
  }
}